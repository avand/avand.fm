#!/usr/bin/env bash
#
# Edit the signup endpoint here, in the repo, and put it live from here too.
#
#   bin/apps-script status   what push would send, and where
#   bin/apps-script pull     bring the live editor's code back down
#   bin/apps-script push     upload the code -- does NOT change what the form hits
#   bin/apps-script deploy   push, cut a version, point the form's URL at it
#   bin/apps-script logs     recent executions
#   bin/apps-script open     the Apps Script editor, in a browser
#
# WHY PUSH AND DEPLOY ARE TWO DIFFERENT THINGS
#
# An Apps Script web app has code and it has deployments, and they move
# independently. `push` replaces the code in the online editor. The form on the
# site does not run that code: it POSTs to a deployment, which is a frozen
# snapshot of some earlier version, and it keeps running that snapshot until a
# deployment is told to advance. So a push alone changes nothing a visitor can
# see, and the execution log will happily show the *old* code running against
# your new file, which is the confusing part.
#
# `deploy` does the other half -- cuts an immutable version from what was just
# pushed and moves the existing deployment onto it. Existing, not new: a new
# deployment gets a new /exec URL, and the form would still be posting at the
# old one. Same URL, new code, is the only shape that works here.
#
# THE DEPLOYMENT IS NOT PINNED IN THIS FILE
#
# It is read out of headroom/index.html, from the SIGNUP_ENDPOINT the form
# actually posts to. That string is the deployment id, so the URL the site uses
# and the deployment this script advances cannot drift apart -- change the
# endpoint and this follows it. A second copy here would be a second thing to
# remember.
#
# WHO YOU ARE
#
# clasp's login is global (~/.clasprc.json), not per-repo, and the Sheet, the
# script, and the ad account are all under avand@avandamiri.com. Pushing as any
# other account fails with a flat 404 on the script id, which reads like a bad
# id rather than a wrong login -- `bin/apps-script status` prints the account
# so that guess is a short one. `clasp login` to change it.

set -euo pipefail
cd "$(dirname "$0")/.."

ENDPOINT_FILE="headroom/index.html"

die() { printf '\033[31m%s\033[0m\n' "$*" >&2; exit 1; }
say() { printf '\033[36m%s\033[0m\n' "$*"; }

command -v clasp >/dev/null || die "clasp is not installed. npm i -g @google/clasp"

# Every command below talks to the remote project, so there is no useful work
# to do without an id. `&& die` would not do here: with set -e, a grep that
# finds nothing makes the whole line exit 1 and the script dies on success.
require_script_id() {
  if grep -q 'SCRIPT_ID_GOES_HERE' .clasp.json; then
    die ".clasp.json still has the placeholder script id.
Open the Headroom CRM Sheet > Extensions > Apps Script > Project Settings,
copy the Script ID, and put it in .clasp.json."
  fi
}

# appsscript.json is the project manifest -- timezone, runtime, and the web
# app's "execute as / who has access" settings. clasp refuses to push without
# it, and writing one by hand would push a guess over whatever the project
# really has. So the first thing a fresh clone does is pull.
require_manifest() {
  [ -f apps-script/appsscript.json ] || die \
    "apps-script/appsscript.json is missing. Run bin/apps-script pull first --
it brings down the project's real manifest instead of pushing a guess over it."
}

# The deployment id is the path segment in .../macros/s/<id>/exec.
deployment_id() {
  local id
  id=$(grep -oE 'macros/s/[A-Za-z0-9_-]+/exec' "$ENDPOINT_FILE" | head -1 | cut -d/ -f3)
  [ -n "$id" ] || die "No /exec URL found in $ENDPOINT_FILE -- has SIGNUP_ENDPOINT moved?"
  printf '%s' "$id"
}

case "${1:-}" in
  status)
    require_script_id
    clasp show-authorized-user
    echo
    say "Script:     $(grep -o '"scriptId": *"[^"]*"' .clasp.json | cut -d'"' -f4)"
    say "Deployment: $(deployment_id)  (from $ENDPOINT_FILE)"
    echo
    clasp show-file-status
    ;;

  pull)
    require_script_id
    clasp pull
    say "Pulled. Diff before committing -- this overwrites apps-script/ with whatever is online."
    ;;

  push)
    require_script_id
    require_manifest
    clasp push --force
    say "Pushed. The live form still runs the old version -- bin/apps-script deploy to change that."
    ;;

  deploy)
    require_script_id
    require_manifest
    dep=$(deployment_id)
    clasp push --force

    # `git describe`-ish: whatever identifies this working tree, so the version
    # list in the Apps Script UI says something more than "no description".
    desc="${2:-$(git log -1 --format='%h %s' 2>/dev/null || date -u +%Y-%m-%dT%H:%MZ)}"

    out=$(clasp create-version "$desc")
    printf '%s\n' "$out"
    version=$(printf '%s' "$out" | grep -oE '[0-9]+' | tail -1)
    [ -n "$version" ] || die "Could not read the new version number out of clasp's output."

    clasp update-deployment --versionNumber "$version" --description "$desc" "$dep"
    say "Deployed version $version to $dep. The form is now running this code."
    ;;

  logs)  require_script_id; clasp tail-logs ;;
  open)  require_script_id; clasp open-script ;;

  *)
    sed -n '3,10p' "$0" | sed 's/^# \{0,1\}//'
    exit 1
    ;;
esac

#!/usr/bin/env bash
#
# Serve avand.fm locally, and over the tunnel if one is available.
#
#   bin/dev              site on :8100, plus the tunnel
#   NO_TUNNEL=1 bin/dev  local only
#
# Video is not served from here. It comes from https://video.avand.fm in
# preview exactly as in production, so any machine can show the page without
# first building 400MB of renditions it has no sources for.
#
# If a stale asset ever bites -- an edit that does not show up, most likely on
# a phone where you cannot open devtools -- it is the browser's heuristic
# caching, not this script. Hard-reload, or add a ?v=2 to the URL.
#
# A tunnel only exists while a cloudflared process is running: it holds an
# outbound connection to Cloudflare, and requests for the hostname are routed
# down that live connection. No process, no tunnel.
#
# This uses its own tunnel, separate from The Intern's. Separate tunnels never
# compete, so both projects can run at once and neither affects the other --
# where sharing one meant The Intern's idle watchdog would take this down after
# thirty minutes of *its* inactivity.

set -euo pipefail
cd "$(dirname "$0")/.."

SITE_PORT="${SITE_PORT:-8100}"
HOSTNAME_FM="fm.avand.dev"
TUNNEL_CONFIG="$HOME/.cloudflared/avand-fm.yml"

started_tunnel=""

cleanup() {
  # Only ever stop what this script started.
  [ -n "${server_pid:-}" ] && kill "$server_pid" 2>/dev/null || true
  if [ -n "$started_tunnel" ]; then
    kill "$started_tunnel" 2>/dev/null || true
  fi
}
trap cleanup EXIT INT TERM

# Python's stock static server, binding every interface so a phone on the LAN
# and the tunnel can both reach it. The site is plain files, and the video it
# references is fetched from R2 by the browser, not served here.
#
# The one thing added on top of the stock handler is Cache-Control: no-store.
# Without it the server sends no caching headers at all, so Safari falls back
# to heuristic freshness and decides for itself how long a file stays good --
# which on a phone, where there is no devtools and no real hard-reload, shows
# up as edits that simply do not appear. Every asset is local and this is a
# preview server, so there is nothing here worth caching.
python3 - "$SITE_PORT" >/dev/null 2>&1 <<'PY' &
import sys
from http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer


class NoStore(SimpleHTTPRequestHandler):
    def end_headers(self):
        self.send_header("Cache-Control", "no-store, must-revalidate")
        self.send_header("Pragma", "no-cache")
        self.send_header("Expires", "0")
        super().end_headers()

    def send_header(self, keyword, value):
        # The parent adds its own Last-Modified/ETag, which is what a cache
        # revalidates against; dropping them keeps it from ever getting a 304.
        if keyword in ("Last-Modified", "ETag"):
            return
        super().send_header(keyword, value)


ThreadingHTTPServer(("", int(sys.argv[1])), NoStore).serve_forever()
PY
server_pid=$!

echo "  local   http://localhost:$SITE_PORT/headroom/"

if [ "${NO_TUNNEL:-}" = "1" ]; then
  echo "  tunnel  skipped (NO_TUNNEL=1)"
else
  if pgrep -f "cloudflared tunnel --config $TUNNEL_CONFIG" >/dev/null 2>&1; then
    echo "  tunnel  https://$HOSTNAME_FM/headroom/  (already running)"
  elif ! command -v cloudflared >/dev/null 2>&1; then
    echo "  tunnel  unavailable (cloudflared not installed)"
  elif [ ! -f "$TUNNEL_CONFIG" ]; then
    echo "  tunnel  unavailable (no $TUNNEL_CONFIG)"
  else
    cloudflared tunnel --config "$TUNNEL_CONFIG" run >/dev/null 2>&1 &
    started_tunnel=$!
    # Give it a moment to register before claiming it works.
    for _ in $(seq 1 20); do
      sleep 1
      if curl -sS -m 5 -o /dev/null "https://$HOSTNAME_FM/headroom/" 2>/dev/null; then break; fi
    done
    echo "  tunnel  https://$HOSTNAME_FM/headroom/"
  fi
fi

echo
echo "Ctrl-C to stop."
wait "$server_pid"
